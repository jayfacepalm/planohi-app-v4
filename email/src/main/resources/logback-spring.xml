<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Register our custom email masking message converter -->
    <conversionRule conversionWord="maskedMsg" converterClass="com.planohi.email.util.EmailMaskingConverter" />

    <!-- Include default spring boot logging setups -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- Define the Console Appender that uses our masked message converter -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [%X{correlationId}] - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <!-- Configure Root loggers -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
